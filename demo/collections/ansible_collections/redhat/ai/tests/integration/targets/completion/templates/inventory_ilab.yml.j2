ilabs:
  hosts:
    aws_ilab:
      ansible_user: "{{ ilab_user }}"
      ansible_host: "{{ ilab_host }}"
      ansible_ssh_private_key_file: "{{ ansible_env.HOME }}/.ssh/{{ ilab_ssh_private_key_filename }}"
      ansible_ssh_extra_args: "{{ ansible_ssh_extra_args }}"
      ansible_python_interpreter: "{{ ansible_python_interpreter }}"
