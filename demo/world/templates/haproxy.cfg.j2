global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon

defaults
    mode        http
    log         global
    option      httplog
    option      dontlognull
    option      http-server-close
    option      forwardfor except 127.0.0.0/8
    retries     3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

frontend http_front
    bind *:{{ lb_frontend_port }}
    default_backend web_servers

backend web_servers
    balance roundrobin
{% for backend in lb_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ backend.port }} check
{% endfor %}

listen stats
    bind *:{{ lb_stats_port }}
    stats enable
    stats uri /stats
    stats refresh 10s
